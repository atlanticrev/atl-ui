{
	"name": "@atlanticrev/atl-ui",
	"version": "1.0.8",
	"private": false,
	"type": "module",
	"sideEffects": false,
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./core.css": "./dist/core.css",
		"./theme.css": "./dist/theme.css",
		"./default.css": "./dist/default.css"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"engines": {
		"node": ">=18.18.0"
	},
	"scripts": {
		"build": "npm run build:js && npm run build:css",
		"dev": "tsup --watch",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check --write --unsafe .",
		"lint:ci": "biome lint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"release:patch": "npm run verify && npm version patch && npm publish",
		"verify": "npm run lint && npm run typecheck && npm run build",
		"build:js": "tsup",
		"build:css": "npm run build:css:core && npm run build:css:theme && npm run build:css:default",
		"build:css:core": "sass --no-source-map src/components/core.scss dist/core.css",
		"build:css:theme": "sass --no-source-map src/components/theme.scss dist/theme.css",
		"build:css:default": "sass --no-source-map src/components/default.scss dist/default.css"
	},
	"peerDependencies": {
		"react": "^18.0.0",
		"react-dom": "^18.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.0",
		"@esbuild-plugins/tsconfig-paths": "^0.1.2",
		"@storybook/addon-essentials": "8.6.15",
		"@storybook/addon-interactions": "8.6.15",
		"@storybook/react-vite": "8.6.15",
		"@testing-library/jest-dom": "^6.4.2",
		"@testing-library/react": "^14.2.2",
		"@testing-library/user-event": "^14.5.2",
		"@types/node": "^25.2.0",
		"@types/react": "^18.2.55",
		"@types/react-dom": "^18.2.19",
		"jsdom": "^24.0.0",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"sass": "^1.77.8",
		"tsup": "^8.0.1",
		"typescript": "^5.4.5",
		"vite": "^5.2.8",
		"vitest": "^1.4.0"
	},
	"style": "dist/default.css"
}
