{
	"name": "@atlanticrev/atl-ui",
	"version": "1.0.12",
	"private": false,
	"workspaces": ["packages/*"],
	"type": "module",
	"sideEffects": false,
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./forms": {
			"types": "./dist/forms.d.ts",
			"import": "./dist/forms.js"
		},
		"./core.css": "./dist/core.css",
		"./theme.css": "./dist/theme.css",
		"./default.css": "./dist/default.css"
	},
	"files": ["dist"],
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"engines": {
		"node": ">=18.18.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=24.0.0 <25",
			"onFail": "error"
		}
	},
	"scripts": {
		"build": "npm run build:js && npm run build:css",
		"build:vanilla": "npm run build --workspace @atlanticrev/atl-ui-vanilla",
		"dev": "tsup --watch",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"typecheck:vanilla": "npm run typecheck --workspace @atlanticrev/atl-ui-vanilla",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"format:fix": "node scripts/format-fix.mjs",
		"check": "biome check --write --unsafe .",
		"hooks:install": "simple-git-hooks",
		"lint:ci": "biome lint .",
		"precommit": "lint-staged",
		"prepare": "npm run hooks:install",
		"test": "vitest run",
		"test:vanilla": "vitest run packages/atl-ui-vanilla",
		"test:watch": "vitest",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"release:patch": "npm run verify && npm version patch && npm publish",
		"verify": "npm run lint && npm run typecheck && npm run build",
		"verify:pilot": "npm run verify:vanilla",
		"verify:vanilla": "npm run lint && npm run verify --workspace @atlanticrev/atl-ui-vanilla",
		"build:js": "tsup",
		"build:css": "npm run build:css:core && npm run build:css:theme && npm run build:css:default",
		"build:css:core": "sass --no-source-map src/components/core.scss dist/core.css",
		"build:css:theme": "sass --no-source-map src/components/theme.scss dist/theme.css",
		"build:css:default": "sass --no-source-map src/components/default.scss dist/default.css"
	},
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.0",
		"@esbuild-plugins/tsconfig-paths": "^0.1.2",
		"@storybook/addon-essentials": "8.6.15",
		"@storybook/addon-interactions": "8.6.15",
		"@storybook/react-vite": "8.6.15",
		"@testing-library/jest-dom": "^6.4.2",
		"@testing-library/react": "^14.2.2",
		"@testing-library/user-event": "^14.5.2",
		"@types/node": "^24.13.3",
		"@types/react": "^18.2.55",
		"@types/react-dom": "^18.2.19",
		"jsdom": "^24.0.0",
		"lint-staged": "15.5.2",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"sass": "^1.77.8",
		"simple-git-hooks": "2.13.1",
		"tsup": "^8.0.1",
		"typescript": "^5.4.5",
		"vite": "^5.2.8",
		"vitest": "^1.4.0"
	},
	"lint-staged": {
		"*.{css,js,jsx,json,jsonc,scss,ts,tsx}": "npm run format:fix --"
	},
	"simple-git-hooks": {
		"pre-commit": "npm run precommit"
	},
	"style": "dist/default.css"
}
