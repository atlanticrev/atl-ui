{
	"compilerOptions": {
		"target": "ES2020",
		"lib": ["DOM", "ES2020"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"baseUrl": ".",
		"paths": {
			"@/*": ["src/*"]
		},
		"strict": true,
		"declaration": true,
		"declarationMap": true,
		"emitDeclarationOnly": false,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"noEmit": true
	},
	"include": ["src", ".storybook", "vitest.config.ts", "tsup.config.ts"]
}
