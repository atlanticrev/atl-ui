{
	"name": "@atlanticrev/atl-ui-vanilla",
	"version": "0.3.1",
	"description": "Zero-dependency Atlantic Review UI Web Components and native CSS recipes.",
	"private": false,
	"type": "module",
	"sideEffects": ["**/*.css"],
	"files": ["dist", "docs"],
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"style": "dist/default.css",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/atlanticrev/atl-ui.git",
		"directory": "packages/atl-ui-vanilla"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./alert": {
			"types": "./dist/alert.d.ts",
			"import": "./dist/alert.js"
		},
		"./autocomplete": {
			"types": "./dist/autocomplete.d.ts",
			"import": "./dist/autocomplete.js"
		},
		"./avatar": {
			"types": "./dist/avatar.d.ts",
			"import": "./dist/avatar.js"
		},
		"./calendar": {
			"types": "./dist/calendar.d.ts",
			"import": "./dist/calendar.js"
		},
		"./collapse": {
			"types": "./dist/collapse.d.ts",
			"import": "./dist/collapse.js"
		},
		"./controllers": {
			"types": "./dist/controllers.d.ts",
			"import": "./dist/controllers.js"
		},
		"./core": {
			"types": "./dist/core.d.ts",
			"import": "./dist/core.js"
		},
		"./define-all": {
			"types": "./dist/define-all.d.ts",
			"import": "./dist/define-all.js"
		},
		"./dialog": {
			"types": "./dist/dialog.d.ts",
			"import": "./dist/dialog.js"
		},
		"./drawer": {
			"types": "./dist/drawer.d.ts",
			"import": "./dist/drawer.js"
		},
		"./date-picker": {
			"types": "./dist/date-picker.d.ts",
			"import": "./dist/date-picker.js"
		},
		"./dropdown": {
			"types": "./dist/dropdown.d.ts",
			"import": "./dist/dropdown.js"
		},
		"./file-upload": {
			"types": "./dist/file-upload.d.ts",
			"import": "./dist/file-upload.js"
		},
		"./input": {
			"types": "./dist/input.d.ts",
			"import": "./dist/input.js"
		},
		"./menu": {
			"types": "./dist/menu.d.ts",
			"import": "./dist/menu.js"
		},
		"./pagination": {
			"types": "./dist/pagination.d.ts",
			"import": "./dist/pagination.js"
		},
		"./icons": {
			"types": "./dist/icons.d.ts",
			"import": "./dist/icons.js"
		},
		"./popup": {
			"types": "./dist/popup.d.ts",
			"import": "./dist/popup.js"
		},
		"./progress": {
			"types": "./dist/progress.d.ts",
			"import": "./dist/progress.js"
		},
		"./search": {
			"types": "./dist/search.d.ts",
			"import": "./dist/search.js"
		},
		"./select": {
			"types": "./dist/select.d.ts",
			"import": "./dist/select.js"
		},
		"./table": {
			"types": "./dist/table.d.ts",
			"import": "./dist/table.js"
		},
		"./tabs": {
			"types": "./dist/tabs.d.ts",
			"import": "./dist/tabs.js"
		},
		"./textarea": {
			"types": "./dist/textarea.d.ts",
			"import": "./dist/textarea.js"
		},
		"./toast": {
			"types": "./dist/toast.d.ts",
			"import": "./dist/toast.js"
		},
		"./tooltip": {
			"types": "./dist/tooltip.d.ts",
			"import": "./dist/tooltip.js"
		},
		"./core.css": "./dist/core.css",
		"./theme.css": "./dist/theme.css",
		"./default.css": "./dist/default.css",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "npm run build:js && npm run build:css",
		"build:js": "tsup --config tsup.config.ts",
		"build:css": "npm run build:css:core && npm run build:css:theme && npm run build:css:default",
		"build:css:core": "sass --no-source-map --style=compressed src/styles/core.scss dist/core.css",
		"build:css:default": "sass --no-source-map --style=compressed src/styles/default.scss dist/default.css",
		"build:css:theme": "sass --no-source-map --style=compressed src/styles/theme.scss dist/theme.css",
		"demo": "vite demo --config demo/vite.config.ts --host 127.0.0.1",
		"demo:build": "vite build demo --config demo/vite.config.ts --outDir ../demo-dist --emptyOutDir",
		"demo:preview": "vite preview demo --config demo/vite.config.ts --host 127.0.0.1 --outDir ../demo-dist",
		"format": "biome check --write . && npm run format:atl",
		"format:atl": "atl-formatter --write \"{src,tests,demo}/**/*.{js,jsx,ts,tsx}\" \"*.{js,jsx,ts,tsx}\"",
		"format:atl:check": "atl-formatter --check \"{src,tests,demo}/**/*.{js,jsx,ts,tsx}\" \"*.{js,jsx,ts,tsx}\"",
		"format:check": "biome format . && npm run format:atl:check",
		"lint": "biome lint .",
		"prepack": "npm run build",
		"prepublishOnly": "npm run verify",
		"storybook": "vite demo --config demo/vite.config.ts --host 127.0.0.1 --open /storybook.html",
		"storybook:build": "npm run demo:build",
		"storybook:test": "vite demo --config demo/vite.config.ts --host 127.0.0.1 --port 4175 --strictPort",
		"test": "vitest run --config vitest.config.ts tests",
		"test:browser": "playwright test --config playwright.config.ts",
		"test:browser:update": "npm run test:browser -- --update-snapshots",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"verify": "npm run verify:base && npm run test:browser && npm run build",
		"verify:base": "npm run lint && npm run format:check && npm run typecheck && npm run test"
	},
	"engines": {
		"node": ">=18.18.0"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"devDependencies": {
		"@atlanticrev/atl-formatter": "0.1.1",
		"@axe-core/playwright": "^4.12.1",
		"@playwright/test": "^1.61.1"
	}
}
